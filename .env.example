# Copy to .env and adjust. Never commit .env.

# Database (also used by docker-compose.yml to create the Postgres user)
DB_URL=jdbc:postgresql://localhost:5432/orchestragent
DB_USER=orchestragent
DB_PASSWORD=change-me

# JWT signing secret (HS256). Must be at least 32 bytes. Generate one with:
#   openssl rand -base64 32
JWT_SECRET=

# SMTP server for login codes (Mailpit in development)
MAIL_HOST=localhost
MAIL_PORT=1025

# Public URL of the web app, used in emails
APP_BASE_URL=http://localhost:5173

# Fixed login code accepted ONLY when the "dev" profile is active. Leave empty to disable.
DEV_LOGIN_CODE=

# Daemon (read by orchestragent-daemon from its own environment, not by the server). Optional.
# Folder for config.json and task folders; default ~/.orchestragent
# ORCHESTRAGENT_HOME=
# Pause between the steps of a mock run, in milliseconds; default 1000
# ORCHESTRAGENT_MOCK_STEP_MS=
# Run the smoke test against the real Claude Code CLI (costs money): set to 1
# ORCHESTRAGENT_RUN_REAL_CLAUDE=
